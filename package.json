{
  "name": "modou",
  "version": "0.17.0",
  "private": true,
  "description": "终端编码 Agent：读懂你的项目、替你在终端里改文件跑命令。",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "bin": {
    "modou": "./packages/tui/src/main.ts",
    "mo": "./packages/tui/src/main.ts"
  },
  "files": [
    "packages/tui/src",
    "skills",
    "README.md",
    "README-CN.md",
    "!packages/tui/src/**/*.test.ts",
    "!packages/tui/src/**/*.test.tsx"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun packages/tui/src/main.ts",
    "build": "bun build packages/tui/src/main.ts --target=bun --outfile dist/modou.js",
    "build:compile": "bun build packages/tui/src/main.ts --compile --outfile dist/modou",
    "pack": "npm pack",
    "pack:dry": "npm pack --dry-run",
    "pack:verify": "bun scripts/pack-verify.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "bun test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "ink": "^5",
    "react": "^18"
  },
  "bundleDependencies": [
    "@modou/core"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "typescript-eslint": "^8.66.0"
  }
}
