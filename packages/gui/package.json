{
  "name": "@modou/gui",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "modou 桌面 GUI（Electron + React，Claude Desktop 式布局）——core 的第二个前端，事件流 Event↑/Command↓ 与 TUI 完全同构",
  "main": "dist/electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node esbuild.mjs && vite build",
    "build:main": "node esbuild.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "start": "electron ."
  },
  "dependencies": {
    "@modou/core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "vite": "^5.4.0"
  }
}
